{
  "name": "gov-project-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "tsx server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "app:sync": "npm run build && cap sync android",
    "app:open": "cap open android",
    "app:build": "npm run app:sync && cd android && gradlew assembleDebug",
    "app:release:apk": "npm run app:sync && cd android && gradlew assembleRelease",
    "app:release:aab": "npm run app:sync && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
